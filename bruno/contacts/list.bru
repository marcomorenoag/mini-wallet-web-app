meta {
  name: List contacts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/contacts
  body: none
  auth: none
}

tests {
  test("lists contacts, favorites first", function () {
    expect(res.getStatus()).to.equal(200);
    const favorites = res.getBody().items.map((item) => item.isFavorite);
    expect(favorites).to.deep.equal([...favorites].sort().reverse());
  });
}
