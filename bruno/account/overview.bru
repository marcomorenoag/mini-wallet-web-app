meta {
  name: Account overview
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/account
  body: none
  auth: none
}

tests {
  test("returns the name and the balance", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().userName).to.equal("Ana López");
    expect(res.getBody().balance.currency).to.equal("MXN");
  });
}
