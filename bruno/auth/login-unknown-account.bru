meta {
  name: Login with an unknown account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "nobody@example.com"
  }
}

tests {
  test("is rejected with problem details", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody().issues).to.deep.equal([{ field: "identifier", code: "IDENTIFIER_NOT_FOUND" }]);
  });
}
