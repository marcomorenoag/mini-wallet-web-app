meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "ana@example.com"
  }
}

tests {
  test("starts a session", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal("Ana López");
  });
}

docs {
  An email or a Mexican phone number (`55 1234 5678`) is accepted. The session is returned in the
  httpOnly `mw_session` cookie, which is sent by Bruno with the following requests.
}
