meta {
  name: Get a transfer (voucher)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/transfers/{{transferId}}
  body: none
  auth: none
}

tests {
  test("returns the completed transfer", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("transferId"));
  });
}
