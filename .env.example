# Mock services configuration. Copy to .env.local to override the defaults.

# Simulated latency of every mock call: "0", "300" (fixed) or "250-700" (range).
# Default: 250-700 (0 under test).
MOCK_LATENCY_MS=250-700

# How long the TIMEOUT scenario holds the transfer response before completing (ms).
MOCK_TIMEOUT_DELAY_MS=15000

# Whether a per-request scenario override is honored: "enabled" or "disabled".
# Default: enabled outside production.
MOCK_SCENARIO_OVERRIDE=enabled

# Whether the session cookie is marked Secure: "true" or "false".
# Default: true in production. Only turned off to serve a production build over plain HTTP (E2E).
# SESSION_COOKIE_SECURE=true
